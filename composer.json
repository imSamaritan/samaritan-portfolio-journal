{
    "name": "portfolio/app",
    "description": "Personal Portfolio and Journal PWA",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/php-view": "^3.4",
        "vlucas/phpdotenv": "^5.6",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
